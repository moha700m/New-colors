<Window x:Class="MohammedLab.ColorVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mohammed Lab Color Vision" Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MOHAMMED LAB" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Color Vision" FontWeight="Bold" FontSize="28" Margin="0,3,0,0"/>
                <TextBlock Text="Real-time color detection • controller diagnostics • profiles" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Stopped"/></StackPanel>
                </Border>
                <Button x:Name="StartStopButton" Style="{StaticResource PrimaryButton}" Content="Start Vision" Click="StartStopButton_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Live Status" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFps" Text="Capture FPS: 0" Margin="0,16,0,4"/>
                        <TextBlock x:Name="TxtDetector" Text="Detector: idle" Margin="0,4"/>
                        <TextBlock x:Name="TxtTarget" Text="Target: none" Margin="0,4"/>
                        <TextBlock x:Name="TxtController" Text="Controller: not detected" Margin="0,4"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Quick Presets" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Fast starting points for common highlight colors." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"/>
                        <WrapPanel><Button Content="Pink / Magenta" Click="PresetPink_Click"/><Button Content="Yellow" Click="PresetYellow_Click"/><Button Content="Red" Click="PresetRed_Click"/><Button Content="Purple" Click="PresetPurple_Click"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Target Inspector" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtInspector" Text="Start Vision to inspect detected regions." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="Capture"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Capture Region" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Width" Margin="0,12,0,0"/><Slider x:Name="SldCaptureWidth" Minimum="160" Maximum="1000" TickFrequency="20" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblCaptureWidth" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Height" Margin="0,10,0,0"/><Slider x:Name="SldCaptureHeight" Minimum="120" Maximum="800" TickFrequency="20" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblCaptureHeight" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Target FPS" Margin="0,10,0,0"/><Slider x:Name="SldCaptureFps" Minimum="30" Maximum="240" TickFrequency="30" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblCaptureFps" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Detection"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="HSV Color Detector" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Hue (0–179)" Margin="0,12,0,0"/><Slider x:Name="SldHue" Minimum="0" Maximum="179" TickFrequency="1" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblHue" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Hue tolerance"/><Slider x:Name="SldHueTolerance" Minimum="1" Maximum="45" TickFrequency="1" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblHueTolerance" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Minimum saturation"/><Slider x:Name="SldSat" Minimum="0" Maximum="255" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblSat" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Minimum brightness"/><Slider x:Name="SldValue" Minimum="0" Maximum="255" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblValue" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Minimum blob area"/><Slider x:Name="SldMinArea" Minimum="2" Maximum="250" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblMinArea" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Target vertical offset"/><Slider x:Name="SldTargetOffset" Minimum="-80" Maximum="80" TickFrequency="1" ValueChanged="ConfigControl_Changed"/><TextBlock x:Name="LblTargetOffset" Foreground="{StaticResource MutedBrush}"/>
                <CheckBox x:Name="ChkSticky" Content="Keep the last detected region briefly during short gaps" Click="ConfigControl_Click"/>
            </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Controller"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Controller Diagnostics" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Physical controller index (0–3)" Margin="0,10,0,0"/><ComboBox x:Name="CmbControllerIndex" SelectionChanged="ConfigControl_Changed"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox>
                <Separator Margin="0,12"/>
                <TextBlock Text="Live Controller Test" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtControllerLive" Text="Start Vision to view live input." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Profiles"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Profile name" Margin="0,12,0,0"/><TextBox x:Name="TxtProfileName"/>
                <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Save Profile" Click="SaveProfile_Click"/><Button Content="Reload" Click="ReloadProfile_Click"/><Button Content="New" Click="NewProfile_Click"/><Button Content="Export" Click="ExportProfile_Click"/><Button Content="Import" Click="ImportProfile_Click"/></WrapPanel>
                <TextBlock x:Name="TxtProfilePath" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Diagnostics"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TxtDiagnostics" Text="No diagnostic data yet." Margin="0,12,0,0" FontFamily="Consolas" TextWrapping="Wrap"/><Button Content="Copy Diagnostics" HorizontalAlignment="Left" Click="CopyDiagnostics_Click"/>
            </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

            <TabItem Header="About"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Mohammed Lab Color Vision" FontSize="22" FontWeight="Bold"/><TextBlock Text="Version 2.0.0" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,12"/><TextBlock Text="Independent Mohammed Lab Windows product for real-time color detection, visual target inspection, controller diagnostics and profiles." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="© 2026 Mohammed Lab. All rights reserved." Margin="0,18,0,0"/>
            </StackPanel></Border></StackPanel></TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="Ready"/><TextBlock Grid.Column="1" Text="Mohammed Lab • v2.0.0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid>
    </Grid>
</Window>
